{
  "name": "rentaflow",
  "private": true,
  "version": "0.1.0",
  "description": "RentaFlow — araç kiralama yönetim sistemi monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:test": "bash scripts/run-db-tests.sh",
    "typecheck:shared": "npm run typecheck -w @rentaflow/shared",
    "typecheck:mobile": "npm run typecheck -w mobile",
    "test:mobile": "npm run test:unit -w mobile",
    "test:step3": "npm run typecheck:shared && npm run typecheck:mobile && npm run test:mobile",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "typecheck:web": "npm run typecheck -w web",
    "start:web": "npm run start -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
