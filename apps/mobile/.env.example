# Copy to apps/mobile/.env for local development
# NEVER commit real secrets. NEVER put SUPABASE_SERVICE_ROLE_KEY here.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key

# Optional monitoring (production)
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_ANALYTICS_KEY=
