# RentaFlow environment template
# Copy to .env / apps/mobile/.env and fill with your Supabase project values.
# NEVER commit real secrets. NEVER put the service role key in client apps.
# Prefer SEPARATE Supabase projects for development vs production.

# --- App environment ---
# development | preview | production
EXPO_PUBLIC_APP_ENV=development
APP_ENV=development

# --- Mobile (Expo) — PUBLIC only ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key

# --- Production mobile (EAS secrets / eas.json env) ---
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_prod_anon_key

# --- Optional monitoring ---
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_ANALYTICS_KEY=
# EXPO_PUBLIC_DEBUG_LOGS=0

# --- Web (Next.js) — used from STEP web panel onward ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Server / CI / Edge Functions only (NEVER EXPO_PUBLIC) ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
# CRON_SECRET=generate_a_long_random_string
