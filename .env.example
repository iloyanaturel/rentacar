# RentaFlow environment template
# Copy to .env / apps/mobile/.env and fill with your Supabase project values.
# NEVER commit real secrets. NEVER put the service role key in client apps.

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Web (Next.js) — used from STEP web panel onward ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Server / CI only (optional) ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
